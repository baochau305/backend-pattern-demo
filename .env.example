# ---- Runtime ----
NODE_ENV=development
PORT=3000

# ---- Datastores (local dev uses localhost; docker-compose overrides with service names) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate a strong secret for any non-local environment, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Rate limiting (per IP) ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# ---- Cache TTLs (seconds) ----
CACHE_TTL_LIST_SEC=60
CACHE_TTL_DETAIL_SEC=120

# ---- Idempotency ----
IDEMPOTENCY_TTL_SEC=86400

# ---- Bull Board (queue dashboard at BULL_BOARD_PATH, protected by HTTP Basic auth) ----
# The dashboard can retry and delete jobs: always set strong credentials outside local dev.
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change_me_in_production
